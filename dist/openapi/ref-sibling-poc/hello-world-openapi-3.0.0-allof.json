{
  "openapi": "3.0.0",
  "info": {
    "title": "Hello World allOf compatibility test",
    "version": "1.0.0",
    "description": "Minimal API for testing contextual schema descriptions using the OpenAPI 3.0.0 allOf pattern.",
    "license": {
      "name": "Open Licence",
      "url": "https://www.openbanking.org.uk/open-licence/"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [

  ],
  "paths": {
    "/hello": {
      "get": {
        "operationId": "getHello",
        "summary": "Return a hello-world message",
        "responses": {
          "200": {
            "description": "A successful hello-world response.",
            "content": {
              "application/json": {
                "schema": {
                  "description": "The greeting returned specifically by GET /hello.",
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/HelloMessage"
                    }
                  ]
                },
                "example": {
                  "message": "Hello, world!"
                }
              }
            }
          },
          "400": {
            "description": "The request could not be processed."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HelloMessage": {
        "type": "object",
        "description": "A reusable message object.",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "description": "The message text.",
            "example": "Hello, world!"
          }
        }
      }
    }
  }
}
